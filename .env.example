# Copy to .env to override the defaults used by docker-compose.yml
GATEWAY_ID=edge-gateway-01
SERVICE_TOKEN=change-me-service-token
SYNC_API_KEY=change-me-sync-key
TIMEZONE=America/Lima
MQTT_HOST=mosquitto
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
SYNC_BASE_URL=http://mock-cloud:9000

# --- Ejecucion local sin Docker (python main.py) ---
EDGE_GATEWAY_ID=edge-gateway-01
EDGE_SERVICE_TOKEN=<edge_service_token>
EDGE_DATABASE_PATH=data/edge-gateway.db
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_AMQP_URL=amqp://guest:guest@localhost:5672/
EDGE_SYNC_BASE_URL=http://localhost:8089
EDGE_SYNC_API_KEY=<edge_sync_api_key>
EDGE_TIMEZONE=America/Lima
